{
  "name": "blindgap-pet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "BUILD_TARGET=electron tsc -b && BUILD_TARGET=electron vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -n vite,ele -k \"npm:dev\" \"sleep 3 && electron . --dev\"",
    "dist:mac": "npm run build:electron && electron-builder --mac --config electron-builder.yml",
    "dist:win": "npm run build:electron && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5"
  }
}
